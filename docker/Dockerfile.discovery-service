# Stage 1: Build
FROM maven:3.9.9-eclipse-temurin-17 AS builder
WORKDIR /build

# Copy entire project
COPY . .

# Build only discovery-service module with its dependencies
RUN mvn clean package -DskipTests -pl discovery-service -am

# Stage 2: Runtime
FROM openjdk:17-jdk-slim
WORKDIR /app
COPY --from=builder /build/discovery-service/target/*.jar app.jar
ENTRYPOINT ["java", "-jar", "app.jar"]